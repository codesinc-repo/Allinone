{
  "expo": {
    "name": "Super App",
    "slug": "super-app-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "superapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#4C6FFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codesinc.superapp"
    },
    "android": {
      "package": "com.codesinc.superapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#4C6FFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
